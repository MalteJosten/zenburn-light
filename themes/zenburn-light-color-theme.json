  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#597259", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.wordlike",
        "punctuation.definition.keyword"
      ],
      "settings": { "foreground": "#80621f", "fontStyle": "bold" }
    },
    {
      "name": "Symbolic operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#3f3f3f", "fontStyle": "" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#656555" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string", "storage.type.string.python"],
